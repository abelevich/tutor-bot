# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
TELEGRAM_WEBHOOK_SECRET=random-secret-string

# LLM — any LiteLLM model string: <provider>/<model>
# Examples: anthropic/claude-sonnet-5-5, openai/gpt-5, gemini/gemini-2.5-pro,
#           openrouter/<model>, ollama/llama3
LLM_MODEL=anthropic/claude-sonnet-5-5
LLM_MAX_TOKENS=1024

# API key for the chosen provider (set the one matching LLM_MODEL)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=...

# Optional overrides (e.g. a local/OpenAI-compatible server)
# LLM_API_KEY=
# LLM_API_BASE=http://localhost:11434

# Database
DATABASE_PATH=./data/tutor.db

# Bot mode: webhook or polling
BOT_MODE=polling

# Tutor defaults
DEFAULT_TARGET_LANGUAGE=en
DEFAULT_PROFICIENCY=B2
DEFAULT_NATIVE_LANGUAGE=ru
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_TOKENS=6000
